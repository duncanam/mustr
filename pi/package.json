{
  "name": "mustr-pi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "description": "Pi adapter bundled with the mustr Rust binary",
  "pi": { "extensions": ["./index.ts"] },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "pretest": "cargo build --manifest-path ../Cargo.toml --locked",
    "test": "node --test test/*.test.mjs ../tests/*.test.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@types/node": "^25.0.0",
    "typebox": "1.3.27",
    "typescript": "^5.9.0"
  }
}
